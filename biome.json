{
	"$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": false,
		"defaultBranch": "release"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"app/web/src/**/*.{ts,tsx,js,json,jsonc,css,scss}",
			"packages/components/**/*.{ts,tsx,json,jsonc,css}",
			"packages/sfu-client/**/*.{ts,tsx,json,jsonc,css}",
			"packages/desktop/**/*.{ts,tsx,json,jsonc}",
			"app/desktop/*.{ts,json,jsonc}",
			"scripts/**/*.{js,mjs}",
			"test/**/*.ts",
			"!app/web/src/routeTree.gen.ts",
			"!app/web/public",
			"!app/web/.vscode",
			"!packages/components/.storybook",
			"!packages/components/storybook-baseline",
			"!packages/components/storybook-static",
			"!packages/sfu-client/dist",
			"!**/.worktrees"
		]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineEnding": "lf"
	},
	"css": {
		"parser": {
			"tailwindDirectives": true,
			"cssModules": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "off",
				"useIterableCallbackReturn": "warn"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn",
				"noUnusedImports": "error",
				"noUnusedVariables": "warn",
				"useHookAtTopLevel": "warn"
			},
			"a11y": {
				"useKeyWithClickEvents": "off",
				"noLabelWithoutControl": "off",
				"noSvgWithoutTitle": "off",
				"noStaticElementInteractions": "warn",
				"useButtonType": "off",
				"useSemanticElements": "off"
			},
			"style": {
				"useSelfClosingElements": "off",
				"useDefaultParameterLast": "off"
			},
			"complexity": {
				"noStaticOnlyClass": "off",
				"noImportantStyles": "off"
			}
		}
	}
}
