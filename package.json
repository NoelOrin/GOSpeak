{
  "name": "go-rtc-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm run dev:web & pnpm run dev:server-web",
    "prod": "pnpm run prod:web & pnpm run prod:server-web",
    "dev:web": "pnpm --filter @go-rtc/web dev",
    "build:web": "pnpm --filter @go-rtc/web build",
    "dev:server": "pnpm --filter @go-rtc/server dev",
    "prod:server": "pnpm --filter @go-rtc/server prod",
    "build:server": "pnpm --filter @go-rtc/server build",
    "test:server": "pnpm --filter @go-rtc/server test",
    "start:dev": "pnpm run dev:server & pnpm run dev:web",
    "start:prod": "pnpm run prod:server",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.2",
    "@commitlint/config-conventional": "^17.7.0",
    "lefthook": "1.8.5"
  }
}