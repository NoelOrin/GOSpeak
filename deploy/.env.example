# =============================================================================
# GOSpeak 部署配置（唯一配置文件，复制为 deploy/.env）
# =============================================================================
# 推荐: ./init.sh  — 自动生成密钥并写出 .env
# 手动: cp .env.example .env 后，至少修改 JWT_KEY 和 LiveKit 密钥
#
# 本文件同时供 docker compose 变量插值与应用容器 env 使用，改一次即可。

# ── 部署档位（改一次，之后命令都是裸 docker compose up -d）──────────────────
#   livekit,app       LiveKit + 应用（默认）
#   可叠加: postgres / rustfs / observability
COMPOSE_PROFILES=livekit,app

# ── Compose ──────────────────────────────────────────────────────────────────
GOSPEAK_PORT=8998
HTTP_PORT=80

# 应用镜像：默认本地构建；可切换为 GHCR 发布镜像（免构建）
# GOSPEAK_IMAGE=ghcr.io/<owner>/gospeak:latest   # 或具体版本如 :1.2.3
# GOSPEAK_PULL_POLICY=missing

# ── 应用 ─────────────────────────────────────────────────────────────────────
APP_ENV=prod
# SERVER_PORT / STATIC_DIR 由镜像固定（8998 / /app/static），通常无需设置

# ── 数据库（SQLite 开箱即用）────────────────────────────────────────────────
DB_TYPE=SQLite
DB_PATH=/app/db/app.db
DB_WAL=true
# PostgreSQL（叠加 --profile postgres 时打开）：
# DB_TYPE=PostgreSQL
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=gospeak
# DB_PASSWORD=change-me
# 或: DB_DSN=host=postgres user=gospeak password=change-me dbname=gospeak port=5432 sslmode=disable

# ── JWT ──────────────────────────────────────────────────────────────────────
# 必改！生成: openssl rand -hex 32
JWT_KEY=please-change-me
JWT_KEY_TTL=24h
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=168h

# ── SFU ──────────────────────────────────────────────────────────────────────
# LiveKit（唯一档位）
SFU_PROVIDER=livekit
LIVEKIT_HOST=ws://livekit:7880
# 必改！KEY/SECRET 需与 livekit/livekit.yaml 的 keys 一致（init.sh 会自动轮换两侧）
# 生成: openssl rand -hex 32
LIVEKIT_KEY=change-me
LIVEKIT_SECRET=change-me

# ── PostgreSQL / RustFS 容器凭据（对应 profile 启用时生效）─────────────────
POSTGRES_USER=gospeak
POSTGRES_PASSWORD=gospeak
POSTGRES_DB=gospeak
POSTGRES_PORT=5432
# RustFS，生产必须改强凭据
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# ── 安全 ─────────────────────────────────────────────────────────────────────
# CORS_ORIGIN=*                     # 默认 * 放行任意来源；生产建议设前端域名白名单
# WS_ALLOWED_ORIGINS=               # WebSocket origin 白名单（空 = same-origin）
# TRUSTED_PROXIES=                  # 信任的代理 IP/CIDR（Nginx 反代后配置）
# 可选：单二进制直跑 HTTPS + HTTP/2（两者需同时配置）
# TLS_CERT=/path/to/fullchain.pem
# TLS_KEY=/path/to/privkey.pem

# ── 存储 / 邮件 ─────────────────────────────────────────────────────────────
STORAGE_TYPE=local
# 凭证加密密钥，生产必设（openssl rand -hex 32）
STORAGE_ENCRYPT_KEY=
EMAIL_ENABLED=false

# ── 内嵌 NATS ───────────────────────────────────────────────────────────────
# NATS_EMBEDDED_PORT=4222           # 留空/0 = 随机端口
# NATS_WAL_PATH=                    # 断线事件磁盘持久化（空 = 禁用）

# ── 日志 / 其他 ─────────────────────────────────────────────────────────────
# LOG_LEVEL=info                    # prod 默认 info/json
# METRICS_TOKEN=                    # GET /metrics Bearer token；空 = 免鉴权

# ── Observability 端口（--profile observability）───────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
