# =============================================================================
# GOSpeak 部署配置 —— 唯一配置文件
# =============================================================================
# 复制为 deploy/.env 即可，一份文件同时供：
#   1. docker compose 变量插值（GOSPEAK_PORT / POSTGRES_* / LIVEKIT_* 等）
#   2. 应用容器环境变量（env_file 注入，服务端全部字段都在这里）
#
# 推荐: ./init.sh  — 自动生成密钥并写出 .env
# 手动: cp .env.example .env 后，至少修改标了【必改】的项
#
# 约定:
#   - 【必改】= 生产上线前必须替换
#   - 注释掉的项 = 有安全默认值，需要时取消注释
#   - 本文件是 compose 与应用共用的唯一来源，不要在别处再维护一份
# =============================================================================

# ── 部署档位 ────────────────────────────────────────────────────────────────
# app,livekit       应用 + LiveKit（默认，已能跑通语音，开箱即用）
# 叠加 edge         启用内置 Caddy：填了 GOSPEAK_DOMAIN 就自动 HTTPS
#                   ./init.sh --domain <域名> 会自动把 edge 加进来
# 已有反代（Nginx/Traefik/Dokploy）时不要开 edge，把反代指向 8998 即可
# 可再叠加: postgres / rustfs / observability
COMPOSE_PROFILES=app,livekit

# ── 域名 / 入口 ─────────────────────────────────────────────────────────────
# 【唯一需要填的域名项】对外的站点域名，如 voice.example.com
#   - 填了：COMPOSE_PROFILES 追加 edge 后，Caddy 自动申请证书并提供 HTTPS
#   - 留空：Caddy 只听 80（局域网 / 前面已有反代），也是不需要域名的默认形态
# LiveKit 不需要第二个域名或证书：信令走应用同源的 /livekit 反代。
GOSPEAK_DOMAIN=

# ── Compose / 端口 ──────────────────────────────────────────────────────────
# 应用对外端口（宿主机映射到容器 8998）
# 自建反代 / Dokploy 指向这里；开 edge 档位时 Caddy 也走容器内网 8998，可忽略
GOSPEAK_PORT=8998

# 应用镜像：默认本地构建；也可直接用 GHCR 发布镜像（免构建）
# GOSPEAK_IMAGE=ghcr.io/<owner>/gospeak:latest
# GOSPEAK_PULL_POLICY=missing

# ── 运行环境 ────────────────────────────────────────────────────────────────
# dev | prod。prod 会强制校验 JWT_KEY / STORAGE_ENCRYPT_KEY，并默认 json 日志
APP_ENV=prod
# 镜像内已固定，通常无需设置：
# SERVER_PORT=8998
# STATIC_DIR=/app/static
# GIN_MODE=release
# bcrypt 哈希工作因子，越高越安全也越慢
# BCRYPT_COST=12

# ── 数据库 ──────────────────────────────────────────────────────────────────
# SQLite 开箱即用，无需外部依赖
DB_TYPE=SQLite
DB_PATH=/app/db/app.db
# SQLite WAL 模式，并发读建议开启
DB_WAL=true

# PostgreSQL（COMPOSE_PROFILES 追加 postgres 时启用）
# DB_TYPE=PostgreSQL
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=gospeak
# DB_PASSWORD=change-me
# 或直接用 DSN:
# DB_DSN=host=postgres user=gospeak password=change-me dbname=gospeak port=5432 sslmode=disable

# Turso / libSQL 远程库（可选，优先级高于 DB_DSN 中的连接串）
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# ── JWT ─────────────────────────────────────────────────────────────────────
# 【必改】生成: openssl rand -hex 32
JWT_KEY=please-change-me
# JWT 签名密钥轮换周期
JWT_KEY_TTL=24h
# access / refresh token 有效期
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=168h

# ── 鉴权 Cookie ─────────────────────────────────────────────────────────────
# 全部走 HttpOnly Cookie，通常无需修改
# ACCESS_COOKIE_NAME=gospeak_token
# REFRESH_COOKIE_NAME=gospeak_refresh_token
# COOKIE_DOMAIN=
# COOKIE_PATH=/
# COOKIE_SECURE=auto          # auto = 直跑 TLS 看 r.TLS，经反代看 X-Forwarded-Proto（Caddy/Nginx 都会传，通常不用改）
# COOKIE_SAMESITE=lax         # lax | strict | none

# ── SFU（LiveKit，唯一支持的音视频后端）────────────────────────────────────
SFU_PROVIDER=livekit

# 后端访问 LiveKit 的地址（admin API / 房间管理 / 踢人）。
# 容器部署填 compose 服务名，走容器内网。
LIVEKIT_HOST=ws://livekit:7880

# 下发给浏览器的连接地址（serverUrl）。
# 【默认留空】留空（或写 auto）时应用会按请求 Host 自动推导：
#   wss://<你的域名>/livekit   —— 信令经应用同源反代，无需额外配置。
# 只有以下情况才显式填写：
#   - LiveKit 用独立域名对外（如 wss://lk.example.com）
#   - 使用 LiveKit Cloud（如 wss://xxx.livekit.cloud）
# 此时应用不再启用同源反代，行为与旧版一致。
LIVEKIT_PUBLIC_URL=

# 【必改】生成: openssl rand -hex 32
# 只需写在这里：compose 会以 LIVEKIT_KEYS / LIVEKIT_WEBHOOK_API_KEY 注入给
# LiveKit 容器，livekit.yaml 不再硬编码密钥，两侧不会不一致。
LIVEKIT_KEY=change-me
LIVEKIT_SECRET=change-me

# ── 安全 / 反代 ─────────────────────────────────────────────────────────────
# 前端来源白名单。默认 * 放行任意来源，生产建议填实际前端域名。
# 例: CORS_ORIGIN=https://app.example.com
CORS_ORIGIN=*
# WebSocket origin 白名单（空 = same-origin 校验）
# WS_ALLOWED_ORIGINS=
# 信任的代理 IP/CIDR，用于从 X-Forwarded-For 取真实客户端 IP（限流/审计依赖）。
# compose 已默认信任 Docker 私网段，一般无需再填。
# TRUSTED_PROXIES=172.16.0.0/12
# 可选：单二进制直跑 HTTPS + HTTP/2（两者需同时配置）
# TLS_CERT=/path/to/fullchain.pem
# TLS_KEY=/path/to/privkey.pem

# ── 存储 ────────────────────────────────────────────────────────────────────
# local | s3
STORAGE_TYPE=local
# 【必改】凭证加密密钥，生产必设，64 位 hex（openssl rand -hex 32）
STORAGE_ENCRYPT_KEY=
# 本地存储落盘目录与访问前缀
# STORAGE_LOCAL_DIR=uploads
# STORAGE_PATH_PREFIX=uploads/
# S3 / R2 / MinIO（STORAGE_TYPE=s3 时启用）
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# 公开访问基础 URL（CDN 或自定义域名）
# STORAGE_PUBLIC_BASE_URL=

# ── 邮箱验证 ────────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_NAME=GoSpeak
# 验证码有效期 / 发送冷却
# EMAIL_CODE_TTL=10m
# EMAIL_SEND_COOLDOWN=60s
# 【启用邮箱验证时必填】验证码签名密钥，勿复用 JWT_KEY
# EMAIL_CODE_SECRET=

# ── OAuth ───────────────────────────────────────────────────────────────────
# 回调时是否自动创建未绑定用户；关闭后仅允许已绑定账号登录
# OAUTH_AUTO_CREATE_USER=true
# OAuth 应用凭据在管理后台配置，存于数据库（加密），无需写在这里

# ── 内嵌 NATS（固定内嵌，不支持外部 NATS_URL）───────────────────────────────
# NATS_SUBJECT_PREFIX=gospeak
# NATS_NAME=
# NATS_CONNECT_TIMEOUT=2s
# NATS_EMBEDDED_PORT=            # 留空/0 = 随机端口
# NATS_WAL_PATH=                 # 断线事件磁盘持久化（空 = 禁用）

# ── 日志 ────────────────────────────────────────────────────────────────────
# LOG_LEVEL=info                 # trace|debug|info|warn|error（空: dev=debug / prod=info）
# LOG_FORMAT=json                # text|json（空: dev=text / prod=json）
# LOG_OUTPUT=stdout              # stdout|stderr|file|both
# LOG_FILE=logs/app.log          # file/both 时生效
# LOG_CALLER=false

# ── 监控 ────────────────────────────────────────────────────────────────────
# GET /metrics 的 Bearer token；空 = 免鉴权
# METRICS_TOKEN=

# ── PostgreSQL / RustFS 容器凭据 ────────────────────────────────────────────
# 对应 profile 启用时生效，生产必须改强凭据
POSTGRES_USER=gospeak
POSTGRES_PASSWORD=gospeak
POSTGRES_DB=gospeak
POSTGRES_PORT=5432
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# ── Observability 端口（observability 档位）─────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
