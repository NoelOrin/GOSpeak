# docker compose 变量 (复制为 deploy/.env)
GOSPEAK_ENV_FILE=./env/app.srs.env
GOSPEAK_PORT=8998
HTTP_PORT=80

# SRS ICE candidate: 本机 127.0.0.1; 局域网/公网填可达 IP
SRS_CANDIDATE=127.0.0.1

POSTGRES_USER=gospeak
POSTGRES_PASSWORD=gospeak
POSTGRES_DB=gospeak
POSTGRES_PORT=5432

MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Cluster（Agent + Worker 集群）──
# CLUSTER_AGENT_TOKEN=<admin-jwt>
# CLUSTER_NODE_SECRET=<per-worker-secret>
# CLUSTER_WORKER_ADVERTISE_URL=https://ws.example.com
# CLUSTER_WORKER1_ADVERTISE_URL=https://ws.example.com
# CLUSTER_WORKER2_ADVERTISE_URL=https://ws.example.com
# CLUSTER_ENTRY_URL=https://ws.example.com

# ── 只读副本（Worker 数据面）──
# 生产建议 Worker 连 PG 从库；留空时 Worker 仍以会话只读方式连主库。
# DB_READ_DSN=host=pg-replica ...  # 也可用 DB_READ_HOST/PORT/USER/PASSWORD/DBNAME
# DB_READ_ONLY=true
# DB_REPLICA_LAG_THRESHOLD=5s

# ── Observability ──
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
