# 复制为 deploy/env/app.srs.env 后使用:
#   export GOSPEAK_ENV_FILE=./env/app.srs.env
#   docker compose -f deploy/docker-compose.yml --profile srs --profile app up -d --build

DB_TYPE=SQLite
DB_PATH=/app/db/app.db
# Worker 生产模式建议改用 PostgreSQL 只读副本：
# DB_TYPE=PostgreSQL
# DB_HOST=postgres
# DB_READ_DSN=host=pg-replica user=gospeak_reader password=... dbname=gospeak port=5432 sslmode=disable
# DB_READ_ONLY=true
# DB_REPLICA_LAG_THRESHOLD=5s

JWT_KEY=please-change-me
JWT_KEY_TTL=24h

SFU_PROVIDER=srs
SRS_HOST=srs
SRS_API_PORT=1985
# 浏览器同源反代入口 (经 nginx :80)
SRS_PUBLIC_HOST=http://localhost
SRS_WHIP_URL=/rtc/v1/whip/
SRS_SECRET=please-set-openssl-rand-hex-32


STORAGE_TYPE=local
STORAGE_ENCRYPT_KEY=
EMAIL_ENABLED=false
SERVER_PORT=8998
STATIC_DIR=/app/static

# NATS event bus (empty = embedded; multi-replica set shared external URL)
# NATS_URL=
# NATS_CONNECT_TIMEOUT=2s
# NATS_EMBEDDED_PORT=4222  # empty/0=random; only used when embedded

# Worker 集群注册身份（每个 Worker 必须不同）
# CLUSTER_NODE_SECRET=change-me

# Cluster unified entry (optional; enables /ws?worker=<node-id> routing via nginx)
# CLUSTER_ENTRY_URL=https://ws.example.com
# Optional Bearer token for GET /metrics; empty disables auth
# METRICS_TOKEN=
