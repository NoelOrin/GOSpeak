{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "port": 3000,
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:web"],
      "url": "http://localhost:3000"
    },
    {
      "name": "web-debug",
      "port": 3001,
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@gospeak/web", "dev", "--", "--port", "3001", "--strictPort"],
      "url": "http://localhost:3001"
    }
  ]
}
