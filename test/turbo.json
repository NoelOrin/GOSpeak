{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"test": {
			"env": ["GOSPEAK_TEST_URL", "GOSPEAK_SERVER_BIN"],
			"inputs": [
				"$TURBO_ROOT$/app/server/**/*.go",
