# GOSpeak 环境变量模板
# 复制为 .env (开发) 或 .env.prod (生产) 后填入真实值
# 应用启动: main.go server -e dev|prod  (默认 prod)
# 详细说明见 docs/deployment-guide.md

# ===================== 数据库 =====================
# 三档渐进 (见 docs/deployment-guide.md §4.1):
#  A SQLite      : DB_TYPE=SQLite              (默认, 零外部 DB)
#  B PostgreSQL  : DB_TYPE=PostgresSQL DB_HOST=postgres  (--profile postgres)
#  C PG+Redis    : B 档 + REDIS_HOST=redis      (--profile postgres-redis)
DB_TYPE="SQLite"               # SQLite | PostgresSQL | MYSQL
DB_HOST=""                     # 非 SQLite 必填 (compose 服务名: postgres)
DB_PORT=""                     # 5432 / 3306
DB_USER=""
DB_PASSWORD=""
DB_PATH=""                     # SQLite 文件路径, 留空用默认 db/app.db

# ===================== Redis (可选) =====================
# 留空 → 跳过 Redis, JWT 用静态密钥
# 填值 → 启用 JWT 轮换 + Token 黑名单
#
# 用 LiveKit 时: 复用 compose 里的 `redis` 服务 → REDIS_HOST="redis"
# 不用 LiveKit (纯 mediasoup/srs) 时: 起独立 app-redis (端口 6380) → REDIS_HOST="app-redis"
# 详见 docs/deployment-guide.md §4.1
REDIS_HOST=""
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# JWT 签名密钥轮换周期 (需 Redis). 例: 24h, 168h(7d)
# TTL 到期生成新密钥, 旧 token 全部失效
# 无 Redis 时忽略, 用静态 JWT_KEY
JWT_KEY_TTL="24h"

# ===================== SFU Provider =====================
# 选择音视频后端: livekit | srs | mediasoup | agora | daily
SFU_PROVIDER="livekit"

# ── LiveKit (Cloud 或自部署) ──
LIVEKIT_HOST=""                # Cloud: wss://<id>.livekit.cloud  自部署: ws://localhost:7880
LIVEKIT_KEY=""
LIVEKIT_SECRET=""

# ── MediaSoup (Node worker) ──
# SFU_PROVIDER="mediasoup"
# MEDIASOUP_BRIDGE_URL="http://localhost:3001"
# MEDIASOUP_HOST="localhost:3001"

# ── SRS ──
# SFU_PROVIDER="srs"
SRS_HOST="localhost"
SRS_API_PORT="1985"
SRS_WHIP_URL="/rtc/v1/whip/"
SRS_SECRET=""
SRS_PUBLIC_HOST=""            # 浏览器可达入口, 如 https://domain 或 http://localhost

# ── Daily 见 AGENTS.md ──

# ── Agora Cloud ──
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""
AGORA_HOST=""
AGORA_CUSTOMER_ID=""
AGORA_CUSTOMER_SECRET=""

# ===================== 对象存储 =====================
# 类型: local | s3
STORAGE_TYPE="local"
# S3 兼容端点 (MinIO: http://localhost:9000, R2: https://<acct>.r2.cloudflarestorage.com)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PATH_PREFIX="uploads/"
# 公开访问基础 URL (可选, 用于 CDN 或自定义域名)
STORAGE_PUBLIC_BASE_URL=""
# 凭证加密密钥 — 生产环境必设! 64 位 hex 字符串 (32 字节)
# 生成: openssl rand -hex 32
STORAGE_ENCRYPT_KEY=""

# ===================== 邮箱验证 =====================
# 渐进式开关：关闭时保持现有注册/登录，重置密码禁用；开启后注册需邮箱验证码，重置密码改用邮箱验证码
EMAIL_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_FROM_NAME="GoSpeak"
# 验证码有效期 (Go duration, 如 10m)
EMAIL_CODE_TTL="10m"
# 同邮箱发送冷却 (Go duration, 如 60s)
EMAIL_SEND_COOLDOWN="60s"
# 验证码签名密钥 (启用邮箱验证时必填, 请勿复用 JWT_KEY)
EMAIL_CODE_SECRET=""


# ===================== Server =====================
SERVER_PORT="8998"
STATIC_DIR=""                  # 生产镜像默认 /app/static; 本地 dev 留空
