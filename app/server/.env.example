# GOSpeak 环境变量模板
# 复制为 .env (开发) 或 .env.prod (生产) 后填入真实值
# 应用启动: main.go server -e dev|prod  (默认 prod)
# 详细说明见 docs/deployment-guide.md


# ===================== 运行环境 =====================
# dev | prod；CLI -e 会在未设置时写入 APP_ENV
APP_ENV=""
# ===================== 数据库 =====================
# 两档渐进 (见 docs/deployment-guide.md §4.1):
#  A SQLite      : DB_TYPE=SQLite              (默认, 零外部 DB)
#  B PostgreSQL  : DB_TYPE=PostgreSQL DB_HOST=postgres  (--profile postgres)
DB_TYPE="SQLite"               # SQLite | PostgreSQL | MySQL（兼容 PostgresSQL/MYSQL 拼写）
DB_HOST=""                     # 非 SQLite 必填 (compose 服务名: postgres)
DB_PORT=""                     # 5432 / 3306
DB_USER=""
DB_PASSWORD=""
DB_PATH=""                     # SQLite 文件路径, 留空用默认 db/app.db
DB_WAL="false"                 # SQLite WAL 模式（并发读建议 true）

# ===================== NATS 事件总线（固定内嵌） =====================
# 总线固定使用进程内嵌 nats-server，单机零外部依赖；不支持外部 NATS_URL。
NATS_SUBJECT_PREFIX="gospeak"
NATS_CONNECT_TIMEOUT="2s"
# NATS_NAME=""   # 可选，实例名；空则自动生成（hostname-pid）
# NATS_EMBEDDED_PORT=""  # 内嵌监听端口；空/0=随机；例: 4222

# 房间成员/stream 状态存于内嵌 NATS JetStream KV（进程内共享，无需配置）
# JWT 签名密钥轮换周期（经 NATS KV 管理）
JWT_KEY="default-secret"      # 生产务必修改；有 NATS KV 时可轮换
JWT_KEY_TTL="24h"

# ===================== SFU Provider =====================
# 唯一支持的音视频后端: livekit
SFU_PROVIDER="livekit"

# ── LiveKit (Cloud 或自部署) ──
LIVEKIT_HOST=""                # Cloud: wss://<id>.livekit.cloud  自部署: ws://localhost:7880
LIVEKIT_KEY=""
LIVEKIT_SECRET=""

# ===================== 对象存储 =====================
# 类型: local | s3
STORAGE_TYPE="local"
# S3 兼容端点 (MinIO: http://localhost:9000, R2: https://<acct>.r2.cloudflarestorage.com)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
# S3 对象键前缀；本地存储忽略此项（文件落在 STORAGE_LOCAL_DIR，公开 URL 为 /uploads/...）
STORAGE_PATH_PREFIX="uploads/"
# 本地存储落盘目录（默认 ./uploads，与 /uploads 静态服务同源）
STORAGE_LOCAL_DIR="uploads"
# 公开访问基础 URL (可选, 用于 CDN 或自定义域名)
STORAGE_PUBLIC_BASE_URL=""
# 凭证加密密钥 — 生产环境必设! 64 位 hex 字符串 (32 字节)
# 生成: openssl rand -hex 32
STORAGE_ENCRYPT_KEY=""

# ===================== 邮箱验证 =====================
# 渐进式开关：关闭时保持现有注册/登录，重置密码禁用；开启后注册需邮箱验证码，重置密码改用邮箱验证码
EMAIL_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_FROM_NAME="GoSpeak"
# 验证码有效期 (Go duration, 如 10m)
EMAIL_CODE_TTL="10m"
# 同邮箱发送冷却 (Go duration, 如 60s)
EMAIL_SEND_COOLDOWN="60s"
# 验证码签名密钥 (启用邮箱验证时必填, 请勿复用 JWT_KEY)
EMAIL_CODE_SECRET=""


# ===================== Server =====================
SERVER_PORT="8998"

# ===================== 日志 =====================
# LOG_LEVEL:  trace|debug|info|warn|error  (空: dev=debug / prod=info)
# LOG_FORMAT: text|json                    (空: dev=text / prod=json)
# LOG_OUTPUT: stdout|stderr|file|both      (默认 stdout)
# LOG_FILE:   file/both 时的路径           (默认 logs/app.log)
# LOG_CALLER: true 时打印调用方
LOG_LEVEL=""
LOG_FORMAT=""
LOG_OUTPUT="stdout"
LOG_FILE="logs/app.log"
LOG_CALLER="false"
CORS_ORIGIN="*"                # 生产建议设为前端域名
STATIC_DIR=""                  # 生产镜像默认 /app/static; 本地 dev 留空
