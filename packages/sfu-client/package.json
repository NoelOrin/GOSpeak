{
	"name": "@gospeak/sfu-client",
	"version": "1.0.1",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./client": {
			"types": "./src/factory.ts",
			"import": "./src/factory.ts"
		},
		"./types": {
			"types": "./src/types.ts",
			"import": "./src/types.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"dev": "tsc --watch",
		"test": "vitest run",
		"check": "biome check",
		"format": "biome format --write"
	},
	"dependencies": {
		"livekit-client": "^2.23.0"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
