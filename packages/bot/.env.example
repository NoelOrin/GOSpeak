GOSPEAK_SERVER_URL=http://localhost:8998
GOSPEAK_SOCKET_URL=http://localhost:8998

# 方式一：直接提供 JWT Token
GOSPEAK_TOKEN=

# 方式二：用户名密码自动登录（推荐）
GOSPEAK_BOT_USERNAME=
GOSPEAK_BOT_PASSWORD=

GOSPEAK_BOT_IDENTITY=gospeak-bot
GOSPEAK_BOT_NAME=GOSpeak Bot
GOSPEAK_PLUGIN_DIR=./plugins

# Comma-separated rooms to join on start
GOSPEAK_AUTO_JOIN_ROOMS=

# Comma-separated rooms to auto-join (signaling)
GOSPEAK_AUTO_JOIN_ROOMS=

# Comma-separated rooms to listen (SFU side + speech pipeline)
GOSPEAK_LISTEN_ROOMS=
GOSPEAK_ENABLE_LISTEN=0
GOSPEAK_ENABLE_SPEAK=0
