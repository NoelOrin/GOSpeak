{
	"name": "@gospeak/bot",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./core": {
			"types": "./src/core/index.ts",
			"import": "./src/core/index.ts"
		},
		"./filters": {
			"types": "./src/filters/index.ts",
			"import": "./src/filters/index.ts"
		},
		"./decorators": {
			"types": "./src/decorators/index.ts",
			"import": "./src/decorators/index.ts"
		},
		"./runtime": {
			"types": "./src/runtime/index.ts",
			"import": "./src/runtime/index.ts"
		},
		"./media": {
			"types": "./src/media/index.ts",
			"import": "./src/media/index.ts"
		},
		"./speech": {
			"types": "./src/speech/index.ts",
			"import": "./src/speech/index.ts"
		},
		"./tts": {
			"types": "./src/tts/index.ts",
			"import": "./src/tts/index.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"lint": "biome check",
		"dev": "tsc --watch",
		"test": "vitest run",
		"start": "tsx src/main.ts",
		"start:prod": "node dist/main.js"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.9"
	},
	"optionalDependencies": {
		"livekit-client": "^2.9.0"
	},
	"dependencies": {
		"@livekit/rtc-node": "^0.13.33",
		"@gospeak/sfu-client": "workspace:*",
		"@seepine/edge-tts": "^1.4.1",
		"mpg123-decoder": "^1.0.3"
	}
}
