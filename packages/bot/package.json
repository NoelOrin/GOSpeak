{
	"name": "@gospeak/bot",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./core": {
			"types": "./src/core/index.ts",
			"import": "./src/core/index.ts"
		},
		"./filters": {
			"types": "./src/filters/index.ts",
			"import": "./src/filters/index.ts"
		},
		"./decorators": {
			"types": "./src/decorators/index.ts",
			"import": "./src/decorators/index.ts"
		},
		"./runtime": {
			"types": "./src/runtime/index.ts",
			"import": "./src/runtime/index.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"lint": "biome check",
		"dev": "tsc --watch",
